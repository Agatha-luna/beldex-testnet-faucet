# Copy this file to .env and fill in real values. .env is gitignored.

# Beldex wallet RPC endpoint used to validate addresses and send faucet funds.
WALLET_URL=http://127.0.0.1:19092/json_rpc

# Amount sent per faucet request, in atomic units (default: 205000000000 = 205 tBDX).
FAUCET_AMOUNT=205000000000

# SQLite database file path (default: beldex.db).
FAUCET_DATABASE=beldex-faucet.db

# Cloudflare Turnstile secret key. The corresponding public site key belongs
# in frontend/js/config.js.
CAPTCHA_SECRET_KEY=replace-with-your-turnstile-secret-key

# Secret used to HMAC-sign the wallet-ownership challenge issued by GET
# /challenge. Generate your own with `openssl rand -hex 32` — never reuse
# this example value, and never commit the real one.
FAUCET_SIGN_SECRET=replace-with-a-random-64-char-hex-string
