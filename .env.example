# Copy this file to .env and fill in real values. .env is gitignored.

# Beldex wallet RPC endpoint used to validate addresses and send faucet funds.
WALLET_URL=http://127.0.0.1:19092/json_rpc

# Amount sent per faucet request, in atomic units (default: 150000000000 = 150 BDX).
FAUCET_AMOUNT=150000000000

# SQLite database file path (default: beldex.db).
FAUCET_DATABASE=beldex-faucet.db
